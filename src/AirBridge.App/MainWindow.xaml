<Window x:Class="AirBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AirBridge.App.Controls"
        mc:Ignorable="d"
        Title="AirBridge"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid">
        <!-- Theme scenery is drawn here, behind the application chrome. -->
        <Canvas x:Name="ThemeCanvas" ClipToBounds="True" IsHitTestVisible="False" />

        <Grid x:Name="ChromeGrid" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="HeaderSpacerRow" Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterSpacerRow" Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="HeaderArea" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="A" FontSize="21" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AirBridge" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="AirPlay レシーバー for Windows"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="テーマ" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ThemeCombo" Width="142" Height="32"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectionChanged="ThemeCombo_SelectionChanged"
                              ToolTip="画面のテーマを切り替えます"
                              Margin="0,0,14,0" />
                    <Border x:Name="StatusPill" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="待機中" Margin="8,0,0,0"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Text="v0.1.0" Margin="14,0,0,0"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Fullscreen toolbar (replaces the normal header while fullscreen). -->
            <Border x:Name="FullscreenBar" Grid.Row="0" Height="40" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AirBridge" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="フルスクリーン" Margin="10,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding Text, ElementName=StatusText}" Margin="16,0,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <Button x:Name="ExitFullscreenButton" Content="全画面を終了 (Esc)"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="28" Padding="12,3" FontSize="11"
                            Click="ExitFullscreenButton_Click"
                            ToolTip="Esc または F11 で終了" />
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid x:Name="MainContent" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VideoColumn" Width="*" />
                    <ColumnDefinition x:Name="SideSpacerColumn" Width="20" />
                    <ColumnDefinition x:Name="SideColumn" Width="390" />
                </Grid.ColumnDefinitions>

                <!-- Video area -->
                <Grid x:Name="VideoArea" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="VideoBorder" Grid.Row="0"
                            Background="{DynamicResource VideoBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                        <controls:VideoHost x:Name="Video" />
                    </Border>

                    <Border x:Name="VideoStatusBar" Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="VideoDot" Width="8" Height="8"
                                         Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="VideoStatusText" Text="待機中" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="VideoSubStatusText" Text="AirPlay 接続を待っています"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="VideoResolutionText" Text=""
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Button x:Name="FullscreenButton" Content="全画面"
                                        Padding="10,4" FontSize="11"
                                        Click="FullscreenButton_Click"
                                        ToolTip="全画面表示（F11 / Esc）" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Side panel -->
                <ScrollViewer x:Name="SidePanel" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Receiver -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="レシーバー" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="デバイス名" Margin="0,14,0,6"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                <TextBox x:Name="ReceiverNameBox" Text="AirBridge"
                                         TextChanged="ReceiverNameBox_TextChanged" />
                                <CheckBox x:Name="AppendHostnameCheckBox"
                                          Content="PC名を付ける（名前@PC名）" Margin="0,10,0,0"
                                          FontSize="12" IsChecked="True"
                                          Checked="ReceiverNameOption_Changed"
                                          Unchecked="ReceiverNameOption_Changed"
                                          ToolTip="オフにすると、AirPlay メニューには名前だけが表示されます。" />
                                <TextBlock x:Name="ReceiverNamePreview"
                                           Text="AirPlay メニュー表示名: AirBridge"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button x:Name="ApplyNameButton" Content="再起動して適用"
                                        Margin="0,8,0,0" HorizontalAlignment="Right"
                                        Padding="10,4" FontSize="11" Visibility="Collapsed"
                                        Click="ApplyNameButton_Click" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ClientText" Text="クライアント: —"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                        <TextBlock x:Name="ModeText" Text="モード: —"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border x:Name="PinPanel" Grid.Column="1" Visibility="Collapsed"
                                            Background="{DynamicResource AccentDarkBrush}" CornerRadius="9"
                                            Padding="12,7">
                                        <StackPanel>
                                            <TextBlock Text="PIN" FontSize="9"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PinText" Text="0000" FontSize="20"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       FontFamily="Consolas" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Button x:Name="StartButton" Content="開始" Margin="0,16,0,0"
                                        Height="42" Style="{StaticResource PrimaryButton}"
                                        Click="StartButton_Click" />
                                <TextBlock x:Name="StartHint"
                                           Text="開始すると、同じネットワーク上の Apple デバイスから選択できます。"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Now playing -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="再生中" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="96" Height="96" CornerRadius="8"
                                            Background="{DynamicResource Surface2Brush}"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Image x:Name="ArtworkImage" Width="96" Height="96"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="Collapsed" />
                                            <TextBlock x:Name="ArtworkFallback" Text="♪" FontSize="34"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TrackTitle" Text="—" FontSize="15"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TrackArtist" Text="" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TrackAlbum" Text="" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"
                                             Margin="0,14,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="PositionText" Text="0:00" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="DurationText" Text="0:00" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Audio -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="オーディオ出力" Style="{StaticResource SectionTitle}" />
                                <ComboBox x:Name="AudioDeviceCombo" Margin="0,12,0,0"
                                          Height="34" DisplayMemberPath="Name" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                            Value="50" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="50%"
                                               Width="42" TextAlignment="Right"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                                <TextBlock Text="AirPlay 側で変更された音量もここに反映されます。"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Advanced -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Expander Header="詳細設定" IsExpanded="False"
                                      Foreground="{DynamicResource MutedBrush}">
                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ポート" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="PortBox" Grid.Column="1" Text="7000"
                                                 TextAlignment="Right" />
                                    </Grid>

                                    <CheckBox x:Name="HlsCheckBox" Content="YouTube アプリの HLS ビデオを受け入れる"
                                              IsChecked="True" Margin="0,12,0,0" />

                                    <TextBlock Text="アクセス制御" Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,12,0,6" />
                                    <ComboBox x:Name="PinModeCombo" SelectedIndex="0">
                                        <ComboBoxItem Content="なし" />
                                        <ComboBoxItem Content="PIN（接続ごとにランダム）" />
                                        <ComboBoxItem Content="パスワード" />
                                    </ComboBox>
                                    <PasswordBox x:Name="PasswordInput" Visibility="Collapsed"
                                                 Margin="0,8,0,0" MinHeight="30" />
                                    <TextBlock x:Name="PasswordHint" Visibility="Collapsed"
                                               Text="4文字以上。次回開始時に反映されます。"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               Margin="0,4,0,0" />

                                    <CheckBox x:Name="NoHoldCheckBox" Content="切断後も映像を保持しない"
                                              Margin="0,12,0,0" />
                                    <CheckBox x:Name="AutoStartCheckBox" Content="起動時に自動で開始"
                                              IsChecked="True" Margin="0,8,0,0" />

                                    <TextBlock Text="変更は次回「開始」時に反映されます。"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Log -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Expander Header="ログ" IsExpanded="False"
                                      Foreground="{DynamicResource MutedBrush}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBox x:Name="LogBox" Height="130" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11"
                                             Background="{DynamicResource LogBackgroundBrush}" />
                                    <Button Content="ログをクリア" HorizontalAlignment="Right"
                                            Margin="0,8,0,0" Padding="10,5" FontSize="11"
                                            Click="ClearLogButton_Click" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid x:Name="FooterArea" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="待機中"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FooterInfo" Grid.Column="1"
                           Text="UxPlay engine"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
